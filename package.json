{
  "name": "tanstack-start-example-basic",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vite dev --port 4000",
    "generate:db": "prisma generate",
    "generate:bible-data": "node ./scripts/generateBibleData.js",
    "generate:sw": "npx workbox generateSW ./workbox-config.cjs",
    "build:app": "vite build",
    "build": "npm run generate:db && npm run generate:bible-data && pnpm run build:app && pnpm run generate:sw",
    "start": "PORT=4000 node .output/server/index.mjs",
    "lint": "npx eslint src --fix",
    "lint:panda-preset": "npx eslint panda-preset --fix"
  },
  "dependencies": {
    "@ark-ui/react": "^5.18.0",
    "@prisma/client": "^6.11.1",
    "@tanstack/react-router": "^1.127.3",
    "@tanstack/react-router-devtools": "^1.127.3",
    "@tanstack/react-start": "^1.127.6",
    "idb-keyval": "^6.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@pandacss/dev": "^0.54.0",
    "@pandacss/preset-panda": "^0.54.0",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "postcss": "^8.5.1",
    "prisma": "^6.11.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.1",
    "vite-tsconfig-paths": "^5.1.4",
    "workbox-cli": "^7.3.0",
    "workbox-window": "^7.3.0"
  }
}
